# Copy this file to `.env` and fill in your keys. `.env` is gitignored.

# --- NVIDIA NIM (default LLM provider, OpenAI-compatible API) ---
NVIDIA_API_KEY=

# --- Reddit provider (optional; enable in config/default.yaml) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- YouTube Data API provider (optional; enable in config/default.yaml) ---
YOUTUBE_API_KEY=

# ===== Stage 2 (Shorts generation) — all optional; config/shorts.yaml =====
# Script generation (Gemini Flash primary; Groq / OpenRouter fallbacks):
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Stock footage (optional; pollinations image gen needs no key):
PEXELS_API_KEY=
PIXABAY_API_KEY=
# YouTube upload (optional; OAuth client secrets JSON path):
YOUTUBE_CLIENT_SECRETS=

# ===== Weekly channel report (shorts-report) =====
# Where the Monday report is emailed (comma-separated for several recipients).
REPORT_EMAIL_TO=
# Optional: lifetime totals + video titles. These are PUBLIC lookups done with
# YOUTUBE_API_KEY (above) instead of the sensitive youtube.readonly OAuth scope.
# Find the id in YouTube Studio > Settings > Channel > Advanced settings.
YOUTUBE_CHANNEL_ID=
# SMTP sender. NOT an Outlook/Microsoft address — Microsoft retired SMTP basic
# auth and app passwords on 2026-04-30. Gmail + a 16-char app password (needs
# 2-Step Verification) is the default; see report.email in config/shorts.yaml.
REPORT_SMTP_USERNAME=
REPORT_SMTP_PASSWORD=
